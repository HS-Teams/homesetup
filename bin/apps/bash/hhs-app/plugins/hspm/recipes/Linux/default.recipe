#!/usr/bin/env bash
function _about_() {

  echo "This is the default recipe and will be used when no recipe is found the specified package"

  return 0
}

function _which_() {

  if command -v "$1" &>/dev/null; then
    return 0
  fi

  return 1
}

function _depends_() {

  return 0
}

function _install_() {

  local sudo_cmd=()

  command -v sudo &> /dev/null && sudo_cmd=(sudo)

  if [[ ${HHS_MY_OS_PACKMAN} == 'apk' ]]; then
    if "${sudo_cmd[@]}" "${HHS_MY_OS_PACKMAN}" add --no-cache "$@"; then
      return 0
    fi
  else
    if "${sudo_cmd[@]}" "${HHS_MY_OS_PACKMAN}" -y install "$@"; then
      return 0
    fi
  fi

  return 1
}

function _uninstall_() {

  local sudo_cmd=()

  command -v sudo &> /dev/null && sudo_cmd=(sudo)

  if [[ ${HHS_MY_OS_PACKMAN} == 'apk' ]]; then
    if "${sudo_cmd[@]}" "${HHS_MY_OS_PACKMAN}" del "$@"; then
      return 0
    fi
  elif [[ ${HHS_MY_OS_PACKMAN} == 'apt' || ${HHS_MY_OS_PACKMAN} == 'apt-get' ||
    ${HHS_MY_OS_PACKMAN} == 'dnf' || ${HHS_MY_OS_PACKMAN} == 'yum' ]]; then
    if "${sudo_cmd[@]}" "${HHS_MY_OS_PACKMAN}" -y remove "$@"; then
      return 0
    fi
  else
    if "${sudo_cmd[@]}" "${HHS_MY_OS_PACKMAN}" uninstall "$@"; then
      return 0
    fi
  fi

  return 1
}
