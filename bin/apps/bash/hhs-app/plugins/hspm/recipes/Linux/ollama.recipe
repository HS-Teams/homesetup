#!/usr/bin/env bash

function _which_() {
  command -v ollama >/dev/null
}

function _install_() {

  local install_script

  install_script="$(mktemp "${TMPDIR:-/tmp}/ollama-install.XXXXXX")" || return 1
  if curl -fsSL 'https://ollama.com/install.sh' -o "${install_script}" &&
    bash "${install_script}"; then
    rm -f "${install_script}"
    return 0
  fi

  rm -f "${install_script}"
  return 1
}

function _uninstall_() {

  local ollama_path exit_code=0 library_path
  local -a library_paths=('/usr/local/lib/ollama' '/usr/lib/ollama' '/lib/ollama')

  ollama_path="$(command -v ollama || true)"
  command -v sudo >/dev/null && SUDO=sudo

  if command -v systemctl >/dev/null; then
    ${SUDO} systemctl stop ollama >/dev/null 2>&1 || true
    ${SUDO} systemctl disable ollama >/dev/null 2>&1 || true
    ${SUDO} rm -f /etc/systemd/system/ollama.service
    ${SUDO} systemctl daemon-reload || exit_code=1
  fi

  if [[ -n "${ollama_path}" ]] && ! ${SUDO} rm -f "${ollama_path}"; then
    exit_code=1
  fi
  for library_path in "${library_paths[@]}"; do
    [[ -d "${library_path}" ]] && ${SUDO} rm -rf "${library_path}" || true
  done
  if id -u ollama >/dev/null 2>&1; then
    ${SUDO} userdel ollama || exit_code=1
  fi
  if getent group ollama >/dev/null 2>&1; then
    ${SUDO} groupdel ollama || exit_code=1
  fi
  [[ -d /usr/share/ollama ]] && ${SUDO} rm -rf /usr/share/ollama || true

  return "${exit_code}"
}
