#!/usr/bin/env bash
function _which_() {
  if command -v ollama &>/dev/null; then
    return 0
  fi
  return 1
}

function _install_() {
  local pkg_url
  local install_script="/tmp/ollama-install.sh"

  pkg_url="https://ollama.com/install.sh"

  if curl -fsSL "$pkg_url" -o "$install_script"; then
    chmod +x "$install_script"
    if bash "$install_script"; then
      rm -f "$install_script"
      return 0
    fi
  fi

  rm -f "$install_script"

  return 1
}

function _stop_ollama_() {
  local sudo_cmd=()

  command -v sudo &>/dev/null && sudo_cmd=(sudo)

  if command -v systemctl &>/dev/null; then
    "${sudo_cmd[@]}" systemctl stop ollama &>/dev/null || true
  fi

  pkill -f 'ollama serve' &>/dev/null || true
}

function _uninstall_() {
  if command -v ollama &>/dev/null; then
    _stop_ollama_
    ollama uninstall
    return 0
  fi

  return 1
}
