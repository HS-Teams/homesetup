#!/usr/bin/env bash
function _about_() {
  echo "This is the default recipe and will be used when no recipe is found the specified package"
  return 0
}

function _which_() {

  if command -v "$1" &>/dev/null ||
    "${HHS_MY_OS_PACKMAN}" list --formula "$1" &>/dev/null; then
    return 0
  fi

  return 1
}

function _depends_() {

  return 0
}

function _install_() {

  if "${HHS_MY_OS_PACKMAN}" install "$@"; then
    return 0
  fi

  return 1
}

function _uninstall_() {

  if "${HHS_MY_OS_PACKMAN}" uninstall "$@"; then
    return 0
  fi

  return 1
}
