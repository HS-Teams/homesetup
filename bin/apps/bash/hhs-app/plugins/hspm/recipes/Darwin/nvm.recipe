#!/usr/bin/env bash

# shellcheck disable=SC1090
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

function _install_() {

  local install_url

  unset nvm
  unset NVM_DIR

  install_url='https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.5/install.sh'

  if curl -fsSL "${install_url}" | bash; then
    export NVM_DIR="${HOME}/.nvm"
    [ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"
    command -v nvm >/dev/null
    return $?
  fi

  return 1
}

function _uninstall_() {

  local ret=0

  [ -d "$NVM_DIR" ] && rm -rf "${NVM_DIR?}" &> /dev/null
  ret=$?
  unset nvm
  unset NVM_DIR

  [ -d "${HOME}/.nvm" ] && rm -rf "${HOME?}/.nvm" &> /dev/null
  [ -d "${HOME}/.npm" ] && rm -rf "${HOME?}/.npm" &> /dev/null
  [ -d "${HOME}/.bower" ] && rm -rf "${HOME?}/.bower" &> /dev/null

  return $ret
}
