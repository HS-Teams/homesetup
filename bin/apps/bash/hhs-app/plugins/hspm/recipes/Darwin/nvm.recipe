#!/usr/bin/env bash

# shellcheck disable=SC1090
export NVM_DIR="${NVM_DIR:-${HOME}/.nvm}"
[ -s "${NVM_DIR}/nvm.sh" ] && \. "${NVM_DIR}/nvm.sh"

function _install_() {

  local install_url

  unset nvm
  unset NVM_DIR

  install_url='https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.5/install.sh'

  if curl -fsSL "${install_url}" | bash; then
    export NVM_DIR="${HOME}/.nvm"
    [ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"
    command -v nvm >/dev/null
    return $?
  fi

  return 1
}

function _uninstall_() {

  local ret=0 directory nvm_dir

  nvm_dir="${NVM_DIR:-${HOME}/.nvm}"
  unset nvm
  unset NVM_DIR

  for directory in "${nvm_dir}" "${HOME}/.nvm" "${HOME}/.npm" "${HOME}/.bower"; do
    [[ -d "${directory}" ]] || continue
    rm -rf -- "${directory}" || ret=1
  done

  return "${ret}"
}
