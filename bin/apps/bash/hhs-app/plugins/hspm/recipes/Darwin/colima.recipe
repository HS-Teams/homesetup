#!/usr/bin/env bash

function _which_() {

  command -v colima >/dev/null && command -v docker >/dev/null
}

function _install_() {

  local package

  for package in colima docker; do
    if ! brew list --formula "${package}" >/dev/null 2>&1; then
      brew install "${package}" || return 1
    fi
  done

  return 0
}

function _uninstall_() {

  local package exit_code=0

  colima stop >/dev/null 2>&1 || true
  for package in colima docker; do
    if brew list --formula "${package}" >/dev/null 2>&1; then
      brew uninstall "${package}" || exit_code=1
    fi
  done

  return "${exit_code}"
}
